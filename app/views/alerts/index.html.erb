<h1>Alerts<%= " for #{@brand.name}" if @brand %></h1>

<p class="meta">
  <strong>Total Alerts:</strong>
  <%= number_with_delimiter(@pagy.count) %>
  <% if @brand %>
    (<%= link_to "Show all brands", alerts_path %>)
  <% end %>
</p>

<div class="card flush">
  <% if @alerts.empty? %>
    <p class="empty">No alerts.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Brand</th>
          <th>Product</th>
          <th>Store Address</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @alerts.each do |alert| %>
          <tr>
            <td class="nowrap"><%= link_to alert.triggered_at.strftime("%Y-%m-%d %H:%M"), alert_path(alert) %></td>
            <td><%= link_to alert.brand.name, brand_path(alert.brand) %></td>
            <td><%= link_to alert.product.name, product_path(alert.product) %></td>
            <td><%= link_to alert.store.address, store_path(alert.store) %></td>
            <td class="nowrap"><span class="badge badge-no">Out of stock, <%= pluralize(alert.streak_length, "check") %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <%= render "shared/pagination" %>
</div>

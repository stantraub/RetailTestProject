<p class="back"><%= link_to "← Brands", brands_path %></p>
<p class="eyebrow">Brand</p>
<h1><%= @brand.name %></h1>

<div class="stats">
  <div class="stat">
    <p class="stat-label">Total Products</p>
    <p class="stat-value"><%= @products.size %></p>
  </div>
  <div class="stat">
    <p class="stat-label">Alerts</p>
    <p class="stat-value">
      <%= link_to pluralize(@alert_count, "alert"), alerts_path(brand_id: @brand.id) %>
    </p>
  </div>
</div>

<div class="card flush">
  <div class="card-head">
    <h2>Recent alerts</h2>
    <% if @alert_count > 0 %>
      <%= link_to "View all #{number_with_delimiter(@alert_count)} #{'alert'.pluralize(@alert_count)}", alerts_path(brand_id: @brand.id), class: "btn" %>
    <% end %>
  </div>
  <% if @recent_alerts.empty? %>
    <p class="empty">No alerts for this brand.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Product</th>
          <th>Store Address</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_alerts.each do |alert| %>
          <tr>
            <td class="nowrap"><%= link_to alert.triggered_at.strftime("%Y-%m-%d %H:%M"), alert_path(alert) %></td>
            <td><%= link_to alert.product.name, product_path(alert.product) %></td>
            <td><%= link_to alert.store.address, store_path(alert.store) %></td>
            <td class="nowrap"><span class="badge badge-no">Out of stock, <%= pluralize(alert.streak_length, "check") %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<div class="card flush">
  <h2>Products</h2>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th class="num">Inventory Events</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= link_to product.name, product_path(product) %></td>
          <td class="num"><%= number_with_delimiter(@event_counts.fetch(product.id, 0)) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

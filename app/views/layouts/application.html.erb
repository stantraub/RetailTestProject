<!DOCTYPE html>
<html>
  <head>
    <title>Retail Inventory</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <nav class="topnav">
        <%= link_to "Retail Inventory", root_path, class: "site-name" %>
        <div class="nav-links">
          <%= nav_link "Stores", stores_path, "stores" %>
          <%= nav_link "Products", products_path, "products" %>
          <%= nav_link "Brands", brands_path, "brands" %>
          <%= nav_link "Alerts", alerts_path, "alerts" %>
        </div>
      </nav>
    </header>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>

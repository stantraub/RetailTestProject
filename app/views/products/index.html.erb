<h1>Products</h1>

<div class="card flush">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Brand</th>
        <th class="num">Inventory Events</th>
      </tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= link_to product.name, product_path(product) %></td>
          <td>
            <% if product.brand %>
              <%= link_to product.brand.name, brand_path(product.brand) %>
            <% end %>
          </td>
          <td class="num"><%= number_with_delimiter(@event_counts.fetch(product.id, 0)) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination" %>
</div>

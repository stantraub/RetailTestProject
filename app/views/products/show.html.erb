<h1><%= @product.name %></h1>

<p>
  <strong>Brand:</strong>
  <% if @product.brand %>
    <%= link_to @product.brand.name, brand_path(@product.brand) %>
  <% else %>
    None
  <% end %>
</p>

<p>
  <strong>Total Inventory Events:</strong>
  <%= @product.inventory_events.size %>
</p>

<h2>Latest Prices</h2>
<% if @latest_prices.empty? %>
  <p>No price data yet.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Store Address</th>
        <th>Price</th>
        <th>As Of</th>
      </tr>
    </thead>
    <tbody>
      <% @latest_prices.each do |price_event| %>
        <tr>
          <td><%= link_to price_event.store.address, store_path(price_event.store) %></td>
          <td><%= number_to_currency(price_event.price) %></td>
          <td><%= price_event.event_time.strftime("%Y-%m-%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Inventory Events</h2>
<table>
  <thead>
    <tr>
      <th>Event Time</th>
      <th>Inventory Present?</th>
      <th>Store Address</th>
    </tr>
  </thead>
  <tbody>
    <% @product.inventory_events.each do |event| %>
      <tr>
        <td><%= event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= event.inventory_present ? "Yes" : "No" %></td>
        <td><%= event.store&.address %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<nav>
  <%= link_to "Back to Products", products_path %> |
  <%= link_to "Brands", brands_path %> |
  <%= link_to "Stores", stores_path %>
</nav>


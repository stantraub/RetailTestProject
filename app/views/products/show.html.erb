<p class="back"><%= link_to "← Products", products_path %></p>
<p class="eyebrow">Product</p>
<h1><%= @product.name %></h1>

<div class="split">
  <section>
    <div class="stats">
      <div class="stat">
        <p class="stat-label">Brand</p>
        <p class="stat-value">
          <% if @product.brand %>
            <%= link_to @product.brand.name, brand_path(@product.brand) %>
          <% else %>
            None
          <% end %>
        </p>
      </div>
      <div class="stat">
        <p class="stat-label">Total Inventory Events</p>
        <p class="stat-value"><%= number_with_delimiter(@pagy.count) %></p>
      </div>
    </div>

    <div class="card flush">
      <h2>Latest Prices</h2>
      <% if @latest_prices.empty? %>
        <p class="empty">No price data yet.</p>
      <% else %>
        <table>
          <thead>
            <tr>
              <th>Store Address</th>
              <th class="num">Price</th>
              <th>As Of</th>
            </tr>
          </thead>
          <tbody>
            <% @latest_prices.each do |price_event| %>
              <tr>
                <td><%= link_to price_event.store.address, store_path(price_event.store) %></td>
                <td class="num"><%= number_to_currency(price_event.price) %></td>
                <td class="nowrap"><%= price_event.event_time.strftime("%Y-%m-%d") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </section>

  <section>
    <div class="card flush">
      <h2>Inventory Events</h2>
      <table>
        <thead>
          <tr>
            <th>Event Time</th>
            <th>In Stock?</th>
            <th>Store Address</th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <tr>
              <td class="nowrap"><%= event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
              <td><%= presence_badge(event.inventory_present) %></td>
              <td><%= event.store&.address %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagination" %>
    </div>
  </section>
</div>

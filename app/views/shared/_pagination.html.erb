<% if @pagy.last > 1 %>
  <p class="pager">
    <span>Page <%= @pagy.page %> of <%= @pagy.last %></span>
    <span class="spacer"></span>
    <% if @pagy.previous %>
      <%= link_to "Previous", @pagy.page_url(:previous), class: "btn" %>
    <% end %>
    <% if @pagy.next %>
      <%= link_to "Next", @pagy.page_url(:next), class: "btn" %>
    <% end %>
  </p>
<% end %>

<h1>Stores</h1>

<div class="card flush">
  <table>
    <thead>
      <tr>
        <th>Address</th>
        <th class="num">Inventory Events</th>
      </tr>
    </thead>
    <tbody>
      <% @stores.each do |store| %>
        <tr>
          <td><%= link_to store.address, store_path(store) %></td>
          <td class="num"><%= number_with_delimiter(@event_counts.fetch(store.id, 0)) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination" %>
</div>

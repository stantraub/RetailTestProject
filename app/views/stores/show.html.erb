<p class="back"><%= link_to "← Stores", stores_path %></p>
<p class="eyebrow">Store</p>
<h1><%= @store.address %></h1>

<div class="split">
  <section>
    <div class="stats">
      <div class="stat">
        <p class="stat-label">Total Inventory Events</p>
        <p class="stat-value"><%= number_with_delimiter(@pagy.count) %></p>
      </div>
      <div class="stat">
        <p class="stat-label">Products Priced</p>
        <p class="stat-value"><%= @latest_prices.size %></p>
      </div>
    </div>

    <div class="card flush">
      <h2>Latest Prices</h2>
      <% if @latest_prices.empty? %>
        <p class="empty">No price data yet.</p>
      <% else %>
        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th class="num">Price</th>
              <th>As Of</th>
            </tr>
          </thead>
          <tbody>
            <% @latest_prices.each do |price_event| %>
              <tr>
                <td><%= link_to price_event.product.name, product_path(price_event.product) %></td>
                <td class="num"><%= number_to_currency(price_event.price) %></td>
                <td class="nowrap"><%= price_event.event_time.strftime("%Y-%m-%d") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </section>

  <section>
    <div class="card flush">
      <h2>Inventory Events</h2>
      <table>
        <thead>
          <tr>
            <th>Event Time</th>
            <th>In Stock?</th>
            <th>Product</th>
            <th>Brand</th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <tr>
              <td class="nowrap"><%= event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
              <td><%= presence_badge(event.inventory_present) %></td>
              <td><%= link_to event.product.name, product_path(event.product) %></td>
              <td><%= event.product.brand&.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= render "shared/pagination" %>
    </div>
  </section>
</div>

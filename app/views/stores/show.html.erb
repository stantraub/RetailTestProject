<h1>Store</h1>

<p>
  <strong>Address:</strong>
  <%= @store.address %>
</p>

<p>
  <strong>Total Inventory Events:</strong>
  <%= @store.inventory_events.size %>
</p>

<h2>Latest Prices</h2>
<% if @latest_prices.empty? %>
  <p>No price data yet.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>As Of</th>
      </tr>
    </thead>
    <tbody>
      <% @latest_prices.each do |price_event| %>
        <tr>
          <td><%= link_to price_event.product.name, product_path(price_event.product) %></td>
          <td><%= number_to_currency(price_event.price) %></td>
          <td><%= price_event.event_time.strftime("%Y-%m-%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2>Inventory Events</h2>
<table>
  <thead>
    <tr>
      <th>Event Time</th>
      <th>Inventory Present?</th>
      <th>Product</th>
      <th>Brand</th>
    </tr>
  </thead>
  <tbody>
    <% @store.inventory_events.each do |event| %>
      <tr>
        <td><%= event.event_time&.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= event.inventory_present ? "Yes" : "No" %></td>
        <td><%= link_to event.product.name, product_path(event.product) %></td>
        <td><%= event.product.brand&.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<nav>
  <%= link_to "Back to Stores", stores_path %> |
  <%= link_to "Products", products_path %> |
  <%= link_to "Brands", brands_path %>
</nav>

